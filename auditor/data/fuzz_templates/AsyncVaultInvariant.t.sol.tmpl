interface IERC20L {
    function balanceOf(address) external view returns (uint256);
    function transfer(address, uint256) external returns (bool);
    function approve(address, uint256) external returns (bool);
}

struct RolesStorage { address whitelistManager; address feeReceiver; address safe; address feeRegistry; address valuationManager; }

interface I7540 {
    function asset() external view returns (address);
    function totalAssets() external view returns (uint256);
    function totalSupply() external view returns (uint256);
    function balanceOf(address) external view returns (uint256);
    function convertToAssets(uint256) external view returns (uint256);
    function convertToShares(uint256, uint256) external view returns (uint256);
    function requestDeposit(uint256, address, address) external payable returns (uint256);
    function requestRedeem(uint256, address, address) external returns (uint256);
    function cancelRequestDeposit() external;
    function deposit(uint256, address) external returns (uint256);
    function mint(uint256, address) external returns (uint256);
    function redeem(uint256, address, address) external returns (uint256);
    function withdraw(uint256, address, address) external returns (uint256);
    function pendingDepositRequest(uint256, address) external view returns (uint256);
    function claimableDepositRequest(uint256, address) external view returns (uint256);
    function pendingRedeemRequest(uint256, address) external view returns (uint256);
    function claimableRedeemRequest(uint256, address) external view returns (uint256);
    function getRolesStorage() external view returns (RolesStorage memory);
    function updateNewTotalAssets(uint256) external;
    function settleDeposit(uint256) external;
    function settleRedeem(uint256) external;
    function syncDeposit(uint256, address, address) external payable returns (uint256);
}

/// Outsider: request / cancel / claim deposit + redeem, donate to the vault, pending silo or safe
/// (price swing). Keeper: honest settlement at the unchanged NAV via the real roles (pranked).
contract AsyncHandler is Test {
    I7540 public immutable v;
    IERC20L public immutable a;
    address public immutable attacker;
    address public immutable safe;
    address public immutable valuer;
    uint256 public calls;

    constructor(I7540 v_, IERC20L a_, address attacker_, address safe_, address valuer_) {
        v = v_; a = a_; attacker = attacker_; safe = safe_; valuer = valuer_;
    }

    function _approve() internal { vm.prank(attacker); a.approve(address(v), type(uint256).max); }

    function requestDeposit(uint256 amt) external {
        uint256 bal = a.balanceOf(attacker);
        if (bal == 0) return;
        amt = bound(amt, 1, bal);
        _approve();
        vm.prank(attacker);
        try v.requestDeposit(amt, attacker, attacker) {} catch {}
        calls++;
    }

    function cancelRequestDeposit() external {
        vm.prank(attacker);
        try v.cancelRequestDeposit() {} catch {}
        calls++;
    }

    function claimDeposit(uint256 amt) external {
        uint256 claimable = v.claimableDepositRequest(0, attacker);
        if (claimable == 0) return;
        amt = bound(amt, 1, claimable);
        vm.prank(attacker);
        try v.deposit(amt, attacker) {} catch {}
        calls++;
    }

    function requestRedeem(uint256 shares) external {
        uint256 bal = v.balanceOf(attacker);
        if (bal == 0) return;
        shares = bound(shares, 1, bal);
        vm.prank(attacker);
        try v.requestRedeem(shares, attacker, attacker) {} catch {}
        calls++;
    }

    function claimRedeem(uint256 shares) external {
        uint256 claimable = v.claimableRedeemRequest(0, attacker);
        if (claimable == 0) return;
        shares = bound(shares, 1, claimable);
        vm.prank(attacker);
        try v.redeem(shares, attacker, attacker) {} catch {}
        calls++;
    }

    function syncDeposit(uint256 amt) external {
        uint256 bal = a.balanceOf(attacker);
        if (bal == 0) return;
        amt = bound(amt, 1, bal);
        _approve();
        vm.prank(attacker);
        try v.syncDeposit(amt, attacker, address(0)) {} catch {}
        calls++;
    }

    /// Price swing: donate assets into the vault itself (may affect convertToAssets of live shares).
    function donateToVault(uint256 amt) external {
        uint256 bal = a.balanceOf(attacker);
        if (bal == 0) return;
        amt = bound(amt, 1, bal);
        vm.prank(attacker);
        a.transfer(address(v), amt);
        calls++;
    }

    /// Price swing: donate into the safe (assets custodian). Honest settlement then quotes the same
    /// NAV, so a pure donation into the safe does not change totalAssets; any gain still needs a
    /// conversion path that reads the live balance.
    function donateToSafe(uint256 amt) external {
        uint256 bal = a.balanceOf(attacker);
        if (bal == 0 || safe == address(0)) return;
        amt = bound(amt, 1, bal);
        vm.prank(attacker);
        a.transfer(safe, amt);
        calls++;
    }

    /// Honest settlement: valuation manager proposes the current totalAssets, safe settles.
    /// Pranking privileged roles is allowed because the question is whether an outsider can
    /// extract value AROUND an honest keeper, not whether a malicious keeper can rug.
    function settleHonest() external {
        if (safe == address(0) || valuer == address(0)) return;
        uint256 nav = v.totalAssets();
        vm.prank(valuer);
        try v.updateNewTotalAssets(nav) {} catch { return; }
        vm.prank(safe);
        try v.settleDeposit(nav) {} catch {
            vm.prank(safe);
            try v.settleRedeem(nav) {} catch {}
        }
        calls++;
    }

    function attackerValue() public view returns (uint256) {
        uint256 shares = v.balanceOf(attacker);
        uint256 pending = v.pendingDepositRequest(0, attacker) + v.claimableDepositRequest(0, attacker);
        uint256 claimableRedeem = v.claimableRedeemRequest(0, attacker);
        uint256 pendingRedeem = v.pendingRedeemRequest(0, attacker);
        uint256 shareAssets = shares == 0 ? 0 : v.convertToAssets(shares);
        // pendingRedeem shares sit in the silo; their eventual claim is at the epoch NAV. Use live convert.
        uint256 redeemAssets = (claimableRedeem + pendingRedeem) == 0
            ? 0 : v.convertToAssets(claimableRedeem + pendingRedeem);
        return a.balanceOf(attacker) + shareAssets + pending + redeemAssets;
    }
}

