/// Attacker actions: deposit / mint / withdraw / redeem, direct donation
/// (price swing) and a single-call flash-loan sequence (borrow -> act -> repay).
contract Handler is Test {
    IERC4626Like public immutable v;
    IERC20Like public immutable a;
    address public immutable attacker;
    address public immutable lender;
    uint256 public immutable budget;
    uint256 public calls;

    constructor(IERC4626Like v_, IERC20Like a_, address attacker_, address lender_, uint256 budget_) {
        v = v_; a = a_; attacker = attacker_; lender = lender_; budget = budget_;
    }

    function _approve() internal { vm.prank(attacker); a.approve(address(v), type(uint256).max); }

    function deposit(uint256 amt) external {
        amt = bound(amt, 1, a.balanceOf(attacker) == 0 ? 1 : a.balanceOf(attacker));
        if (a.balanceOf(attacker) == 0) return;
        _approve(); vm.prank(attacker);
        try v.deposit(amt, attacker) {} catch {}
        calls++;
    }

    function mint(uint256 shares) external {
        shares = bound(shares, 1, 1e30);
        _approve(); vm.prank(attacker);
        try v.mint(shares, attacker) {} catch {}
        calls++;
    }

    function redeem(uint256 shares) external {
        uint256 bal = v.balanceOf(attacker);
        if (bal == 0) return;
        shares = bound(shares, 1, bal);
        vm.prank(attacker);
        try v.redeem(shares, attacker, attacker) {} catch {}
        calls++;
    }

    function withdraw(uint256 amt) external {
        amt = bound(amt, 1, 1e30);
        vm.prank(attacker);
        try v.withdraw(amt, attacker, attacker) {} catch {}
        calls++;
    }

    /// Price swing: donate assets straight to the vault (share-price manipulation).
    function donate(uint256 amt) external {
        uint256 bal = a.balanceOf(attacker);
        if (bal == 0) return;
        amt = bound(amt, 1, bal);
        vm.prank(attacker);
        a.transfer(address(v), amt);
        calls++;
    }

    /// Flash-loan sequence in one call: borrow `amt` from the lender, deposit,
    /// optionally donate, redeem everything, repay. Reverts (no state) if unpaid.
    function flashSequence(uint256 amt, uint256 donateBps) external {
        amt = bound(amt, 1, a.balanceOf(lender));
        if (amt == 0) return;
        donateBps = bound(donateBps, 0, 5000);
        vm.prank(lender); a.transfer(attacker, amt);
        _approve();
        vm.startPrank(attacker);
        try v.deposit(amt, attacker) {} catch {}
        uint256 d = amt * donateBps / 10000;
        if (d > 0 && a.balanceOf(attacker) >= d) a.transfer(address(v), d);
        uint256 sh = v.maxRedeem(attacker);
        if (sh > 0) { try v.redeem(sh, attacker, attacker) {} catch {} }
        require(a.balanceOf(attacker) >= amt, "flash: cannot repay");
        a.transfer(lender, amt);
        vm.stopPrank();
        calls++;
    }

    // No time warp: legitimate yield accrual to a holder would read as "profit".
    // Flash-loan / price-swing takes are same-block, so the invariant runs at the pinned block.

    function attackerValue() public view returns (uint256) {
        uint256 sh = v.balanceOf(attacker);
        return a.balanceOf(attacker) + (sh == 0 ? 0 : v.convertToAssets(sh));
    }
}

